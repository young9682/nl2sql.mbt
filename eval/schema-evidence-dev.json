      "telescopes": ["id", "observatory_id", "code", "aperture_mm", "commissioned_on"]
    },
    "sports_league": {
      "matches": ["id", "home_team_id", "away_team_id", "played_on", "home_score", "away_score", "venue"],
      "people": ["id", "nickname", "joined_on"],
      "roster": ["id", "team_id", "person_id", "role", "left_on"],
      "teams": ["id", "name", "division"]
    }
  },
