{
  "schemas": {
    "food_cooperative": {
      "carriers": ["id", "label"],
      "depots": ["id", "label", "zone"],
      "inventory": ["item_id", "depot_id", "units", "last_counted_on", "lot_code"],
      "items": ["id", "label", "brand", "unit_weight", "diet_code"],
      "shipments": ["id", "depot_id", "item_id", "dispatched_on", "parcel_count", "carrier_id"]
    },
    "observatories": {
